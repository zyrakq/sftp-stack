# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, forwarding/.env.example, filesystem/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=sftp

# Docker image
IMAGE=atmoz/sftp:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

SFTP_USER=backupuser
# or pubkey
SFTP_PASSWORD=
# ssh-keygen -t ed25519 -C sftp -f ./sftp
SFTP_PUB_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEZ7W0rrFtxd5nb4UrSNgThLKeZfR1QvM+A5xWxmteEC sftp

SFTP_UID=1000
SFTP_GID=1000

SFTP_HOME=/home/${SFTP_USER}
SFTP_FOLDER=databases
# Forwarding

SFTP_IP=0.0.0.0
SFTP_PORT=2222
# Mount Filesystem

SFTP_FILESYSTEM=/var/lib/docker/volumes